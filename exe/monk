#!/usr/bin/env ruby
require_relative "../lib/monk/scaffold"

USAGE = "Usage: monk new APP_NAME [--postgres] [--auth]".freeze

HELP = <<~TEXT.freeze
  #{USAGE}

  Creates a new Monk project at APP_NAME from a static skeleton -- refuses
  to run if APP_NAME already exists.

  Base skeleton: Gemfile, config.ru, .ruby-version

  Options:
      --postgres      Also scaffold Postgres persistence/migrations support:
                       config/persistence.rb, bin/console, bin/setup_db,
                       bin/migrate, db/migrate/
      --auth          Also scaffold Monk::Auth (passwordless token auth).
                       Implies --postgres -- Auth is Postgres-only, so this
                       always brings the persistence scaffold with it. Adds
                       config/auth.rb and a migration creating the
                       login_tokens/sessions tables it needs.

  Commands:
      new APP_NAME    Create a new project (see Options above)
      help            Show this help (also --help, -h)

  After creating a project:
      cd APP_NAME
      bundle install

  With --postgres (or --auth, which implies it), a reachable Postgres is
  expected (env vars documented in the generated config/persistence.rb),
  then:
      bin/setup_db    Apply pending migrations
      bin/migrate     migrate | rollback [N] | status
      bin/console     IRB with persistence loaded

  With --auth, also set AUTH_SECRET (e.g. in .env) before booting the app --
  config/auth.rb reads it via ENV.fetch and raises if it's missing.
TEXT

def usage_error!
  warn USAGE
  exit 1
end

command, *rest = ARGV

case command
when nil, "help", "--help", "-h"
  puts HELP
when "new"
  app_name = rest.find { |arg| !arg.start_with?("-") }
  usage_error! if app_name.nil?

  auth = rest.include?("--auth")
  Monk::Scaffold.new(app_name, postgres: rest.include?("--postgres"), auth: auth).write!

  puts "Created #{app_name}. Next steps:"
  puts "  cd #{app_name}"
  puts "  bundle install"
  puts "  export AUTH_SECRET=... (or add it to .env) -- config/auth.rb requires it" if auth
else
  usage_error!
end
