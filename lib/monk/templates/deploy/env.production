# Copied to .env.production on the host by bin/deploy_env, which fills in
# the secrets. Never commit .env.production, never bake it into the image,
# and keep a copy with every database backup: its secrets are what the
# data was written with. Read by every service in compose.yaml. One
# KEY=value per line, no comment after a value.

# production, or staging: the same, logging to log/staging.log.
MONK_ENV=production

# This app's public origin, and Caddy's site address: its host.
PUBLIC_URL=https://app.example.com
SITE_ADDRESS=app.example.com
