#!/usr/bin/env ruby
require "bundler/setup"
# A service that's down, a missing database or setting ends this script
# with what to fix (SETUP.md's commands), not a backtrace.
require "monk/bin"

Monk::Bin.run(__FILE__) do
  # The configs and app/, as the web process loads them, so a job can use
  # the app's models and mailers, send mail, or push a Live update --
  # config/load.rb, never Monk.boot: this process serves no routes.
  require_relative "../config/load"
  require "monk/jobs/runtime"

  # The app's templates, so a job can render one (a mail's HTML part, say):
  # there's no App class here to point Monk::Views at them.
  Monk::Views.root = File.expand_path("../app/views", __dir__)

  workers = Integer(ENV.fetch("JOBS_WORKERS", "5"))
  queues = ENV.fetch("JOBS_QUEUES", "mailers,default").split(",").map(&:strip)
  puts "Monk::Jobs: #{workers} worker(s) on #{queues.join(", ")} -- TERM or Ctrl-C finishes the jobs in hand and stops"
  $stdout.flush

  Monk::Jobs::Runtime.new(workers: workers, queues: queues).run
end
