<h1>Log in</h1>

<%# A plain form: POST /auth/request (app/routes/auth.rb) renders this page
    again, with @sent once the link is on its way, or with @error and a
    422 or 429. %>
<% if @sent %>
  <p>Check your email for the link.</p>
<% else %>
  <% if @error %><p role="alert"><%= @error %></p><% end %>
  <form id="login" method="post" action="/auth/request">
    <label>Email <input type="email" name="email" value="<%= params[:email] %>" required autocomplete="email"></label>
    <button>Send me a login link</button>
  </form>
<% end %>
