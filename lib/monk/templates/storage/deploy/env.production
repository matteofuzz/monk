# File storage: an S3 bucket. file:// keeps files in the container, lost
# on every deploy unless a volume is mounted there; it also needs
# STORAGE_SECRET to sign its links (uncomment it: bin/deploy_env fills it).
STORAGE_URL=s3://KEY:SECRET@bucket?endpoint=fsn1.your-objectstorage.com&region=fsn1
# STORAGE_SECRET=
